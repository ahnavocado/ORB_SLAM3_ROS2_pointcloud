<?xml version="1.0"?>
<package format="3">
    <name>orbslam3_ros2_pointcloud</name>
    <version>0.0.1</version>
    <description>ROS 2 package for ORB_SLAM3 pointcloud integration.</description>
    <maintainer email="ahn.avocado@gmail.com">Sukyum Ahn</maintainer>
    <author>Sukyum Ahn</author>
    <license>MIT</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>sensor_msgs</depend>
    <depend>cv_bridge</depend>
    <depend>message_filters</depend>
    <depend>Pangolin</depend>
    <depend>image_transport</depend>
    <depend>tf2_ros</depend>
    <depend>nav_msgs</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>geometry_msgs</depend>


    <export>
        <build_type>ament_cmake</build_type>
    </export>
